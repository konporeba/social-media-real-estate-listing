# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Langfuse (LLM observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=property-images

# Meta (Facebook + Instagram) — use System User token
META_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=

# Gmail (error alerts)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
EMAIL_APPROVAL_SECRET=7

# Review notifications — sent to the end user when posts are ready for approval
RECIPIENT_NAME=
RECIPIENT_EMAIL=

# Schedule
SCHEDULE_DAY_OF_WEEK=thu
SCHEDULE_HOUR=17
SCHEDULE_TIMEZONE=Europe/Madrid

# Cost guardrail
DAILY_COST_CAP_USD=5.00

# PIN-based session auth
# Generate SESSION_SECRET:   python -c "import secrets; print(secrets.token_hex(32))"
# Generate PIN hash:         python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PIN', bcrypt.gensalt()).decode())"
SESSION_SECRET=
ADMIN_PIN_HASH=
REVIEWER_PIN_HASH=

# Cloudflare Access (no longer used for auth — kept for reference)
# CLOUDFLARE_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CLOUDFLARE_ACCESS_AUD=

# Browser worker (internal service)
BROWSER_WORKER_URL=http://browser-worker:8001

# App
FRONTEND_URL=https://agent.yourdomain.com
CORS_ORIGINS=https://agent.yourdomain.com,http://localhost:5173
LOG_LEVEL=INFO

# Publishing mode: shadow | live
PUBLISH_MODE=shadow

# Local dev only — set true to bypass Cloudflare Access JWT check
AUTH_DISABLED=false
